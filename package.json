{
  "name": "session-zero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Session Zero — a procedural fantasy character name generator for D&D players and DMs.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stress": "vite-node tools/stress.ts",
    "stress:full": "vite-node tools/stress.ts --full",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-node": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
